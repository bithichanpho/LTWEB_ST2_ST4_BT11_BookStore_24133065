<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<c:set var="ctx" value="${pageContext.request.contextPath}" />
<div class="row justify-content-center"><div class="col-lg-6"><div class="card-soft p-4 p-md-5"><div class="text-center mb-4"><div class="display-6" style="color:#285b40"><i class="bi bi-book-half"></i></div><h3 class="mt-2" style="color:#285b40;font-weight:800">Đăng nhập</h3><p class="text-muted-green">Đăng nhập để mua sách, quản lý giỏ hàng và theo dõi đơn hàng.</p></div><c:if test="${not empty error}"><div class="alert alert-danger">${error}</div></c:if><c:if test="${not empty param.registered}"><div class="alert alert-success">Kích hoạt tài khoản thành công! Vui lòng đăng nhập.</div></c:if><c:if test="${not empty param.adminRequired}"><div class="alert alert-danger">Bạn cần tài khoản Admin để vào khu vực quản trị.</div></c:if><form action="${ctx}/login" method="post"><div class="mb-3"><label class="form-label">Email</label><input class="form-control" type="email" name="email" value="${email}" required></div><div class="mb-3"><label class="form-label">Mật khẩu</label><input class="form-control" type="password" name="passwd" required></div><button class="btn-custom btn-custom-primary w-100" type="submit"><i class="bi bi-box-arrow-in-right"></i> Đăng nhập</button></form><div class="text-center mt-3 text-muted-green">Chưa có tài khoản? <a href="${ctx}/register">Đăng ký ngay</a></div></div></div></div>
